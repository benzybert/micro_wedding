# Postgres connection string. Leave empty in local dev: the app then runs on an
# embedded PGlite database stored in .data/pglite (zero setup).
# Production (Vercel): use the POOLED connection string (Supabase "transaction pooler" / Neon pooled).
DATABASE_URL=

# Long-running hosts (Railway): apply pending SQL migrations at server start. Requires DATABASE_URL.
# Leave unset on Vercel, which migrates during the build instead.
AUTO_MIGRATE=
